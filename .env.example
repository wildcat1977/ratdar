APP_NAME="Mouse Radar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 預設 MySQL；如要改 PostgreSQL，DB_CONNECTION=pgsql 且 DB_PORT=5432
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mouse_radar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mouseradar.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Socialite =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI="${APP_URL}/auth/line/callback"

# ===== 雷達設定 =====
RADAR_NEARBY_RADIUS_KM=1
RADAR_DEFAULT_LAT=25.0330
RADAR_DEFAULT_LNG=121.5654

# ===== 管理員保護 =====
# Comma-separated emails whose admin rights cannot be revoked via the panel
PROTECTED_ADMIN_EMAILS=
RADAR_DEFAULT_ZOOM=13

VITE_APP_NAME="${APP_NAME}"
